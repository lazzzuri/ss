# Адрес сайта (для canonical, sitemap, Open Graph). На Vercel можно не задавать: возьмётся домен проекта.
NEXT_PUBLIC_SITE_URL=https://example.com

# База данных Postgres (Neon / Supabase / любая). Таблицы создаются автоматически.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Хранилище картинок блога (Vercel Blob). Без него картинки хранятся в базе.
BLOB_READ_WRITE_TOKEN=

# Админка /admin
ADMIN_PASSWORD=
# Секрет для подписи сессии (любая длинная случайная строка)
ADMIN_SECRET=

# Ежедневный автопост
CRON_SECRET=
ANTHROPIC_API_KEY=
# Генерация картинок: одно из двух. Без ключей рисуется абстрактная обложка.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Уведомления о заявках в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Аналітика (необов'язково): карти кліків і записи сесій Microsoft Clarity, Google Analytics 4
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GA_ID=

# Тонке налаштування автопосту (необов'язково)
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_IMAGE_MODEL=gpt-image-1
# AUTOPOST_STATUS=draft   # публікувати як чернетку для перевірки
